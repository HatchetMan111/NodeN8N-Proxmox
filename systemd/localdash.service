[Unit]
Description=LocalDash - lokales System- und Service-Dashboard
Documentation=https://github.com/HatchetMan111/NodeN8N-Proxmox
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=localdash
Group=localdash
WorkingDirectory=/opt/localdash/app
EnvironmentFile=/etc/localdash/config.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/localdash/venv/bin/uvicorn localdash.main:app --host 0.0.0.0 --port 8080 --proxy-headers
Restart=always
RestartSec=2
TimeoutStopSec=20
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=localdash
StateDirectoryMode=0750
ReadWritePaths=/var/lib/localdash

[Install]
WantedBy=multi-user.target
